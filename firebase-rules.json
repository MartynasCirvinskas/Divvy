{
  "rules": {
    "groups": {
      "$groupId": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": "auth != null && (!data.exists() || data.child('members').child(auth.uid).exists())",
        "members": {
          "$memberId": {
            ".write": "auth != null && (auth.uid == $memberId || data.parent().child(auth.uid).exists())"
          }
        }
      }
    },
    "codes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || (newData.val() == null && root.child('groups').child(data.val()).child('members').child(auth.uid).exists()))"
      }
    }
  }
}
